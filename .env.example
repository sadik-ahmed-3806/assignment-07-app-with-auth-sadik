# Copy this file to .env and replace the example values.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
BETTER_AUTH_DB_URL=mongodb+srv://<username>:<password>@<cluster>/<database>
BETTER_AUTH_DB_NAME=bazardor

# Optional social sign-in credentials. Add both values for a provider to enable it.
# Google authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
